# Required for application startup and AI investigation
GROQ_API_KEY=

# Optional live Razorpay integration
RAZORPAY_API_KEY=
RAZORPAY_API_SECRET=

# Optional API-key authentication. WARNING: if left unset, RBAC is bypassed and
# every request is treated as Role.ADMIN (no key needed) -- see backend/rbac.py.
# Fine for local demos; do NOT leave unset in any deployment reachable by untrusted callers.
NIVARA_API_KEY=
# Example role mapping: NIVARA_ROLE_ops=admin

# Optional database abstraction setting. The active AuditLogger uses SQLite by default.
NIVARA_DATABASE_URL=

# Optional task-queue setting. The synchronous API path does not require Redis.
REDIS_URL=
CELERY_BROKER_URL=
